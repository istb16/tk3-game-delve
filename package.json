{
  "name": "tk3-game-delve",
  "version": "0.1.9",
  "private": true,
  "description": "DELVE - Go deeper. Survive longer. A single-page roguelike dungeon crawler.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node build/inline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure": "node tools/measure-difficulty.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
